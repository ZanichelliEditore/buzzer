{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "dedoc/scramble": "^0.13.26",
        "laravel/framework": "^13.0",
        "laravel/legacy-factories": "^1.4.2",
        "laravel/passport": "^13.4.4",
        "laravel/telescope": "^5.18.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.3",
        "zanichelli/healthcheck": "^1.1.7",
        "zanichelli/idp-extensions": "^3.8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.21",
        "filp/whoops": "^2.18.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-y2cr-5h3j-g3ys"
                ]
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
